# ==============================================================================
# DalaShift: Environment Variable Reference
# ==============================================================================
# This file documents EVERY environment variable the platform expects.
#
# Rules:
#   - Values below are PLACEHOLDERS ONLY. Never commit real credentials.
#   - Copy to `.env.local` for local development: `cp .env.example .env.local`
#   - `.env.local` is gitignored. Only `.env.example` is tracked.
#   - Variables prefixed with NEXT_PUBLIC_ are bundled into the browser bundle.
#     NEVER put a secret in a NEXT_PUBLIC_ variable.
#
# Deployment target for the MVP: Vercel (serverless). Environment variables are
# configured per-deployment in the Vercel dashboard, scoped by environment.
#
# ------------------------------------------------------------------------------
# THE MVP SET. These four are the blocking ones. Get them first.
# ------------------------------------------------------------------------------
#   NEXT_PUBLIC_SUPABASE_URL        Supabase project settings
#   NEXT_PUBLIC_SUPABASE_ANON_KEY    Supabase project settings
#   SUPABASE_SERVICE_ROLE_KEY        Supabase project settings, server only
#   NEXT_PUBLIC_MAP_STYLE_URL        A keyless MapLibre style, see docs/build/BACKEND.md
#
# Get the Earthdata account TODAY. It is the one approval that can take real
# time, and NASA CMR, AppEEARS and GES DISC all need it.
# ------------------------------------------------------------------------------
# ==============================================================================


# ──────────────────────────────────────────────────────────────────────────────
# Supabase (Database, Auth, Storage, PostGIS)
# ──────────────────────────────────────────────────────────────────────────────
# Project URL and anon key are safe to expose to the browser ONLY because
# Row Level Security (RLS) is the access control boundary.
# Supabase docs: https://supabase.com/docs/guides/api
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_PUBLISHABLE_KEY"

# SERVICE ROLE KEY: server-side only. Grants full bypass of RLS.
# NEVER expose to the browser, never prefix with NEXT_PUBLIC_, never commit.
# Rotate immediately if it is ever leaked. Generate under
# Supabase Dashboard → Project Settings → API.
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"


# ──────────────────────────────────────────────────────────────────────────────
# Application
# ──────────────────────────────────────────────────────────────────────────────
# Canonical public URL of the deployment. Used for auth redirects,
# share links and generated report metadata.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Supabase Auth redirect allowlist entries must include:
#   http://localhost:3000/auth/callback
#   https://<your-vercel-domain>/auth/callback
# Add under Supabase Dashboard → Authentication → URL Configuration.


# ──────────────────────────────────────────────────────────────────────────────
# Map rendering (MapLibre GL JS)
# ──────────────────────────────────────────────────────────────────────────────
# MapLibre needs a raster or vector style URL. Options are documented in
# docs/api/map-tile-providers.md. At least ONE of the two below must be set.
#
# NEXT_PUBLIC_MAP_STYLE_URL: a full MapLibre style JSON URL, e.g.
#   "https://api.maptiler.com/maps/streets-v2/style.json?key=YOUR_KEY"
#   "https://tiles.openfreemap.org/styles/bright"
# NEXT_PUBLIC_MAP_TILE_URL: a raster tile template used to build a minimal
#   style in-app, e.g. "https://tile.openstreetmap.org/{z}/{x}/{y}.png"
NEXT_PUBLIC_MAP_STYLE_URL=""
NEXT_PUBLIC_MAP_TILE_URL=""

# Attribution string rendered in the map corner. REQUIRED for all providers.
# Most providers also require attribution in the README / docs.
NEXT_PUBLIC_MAP_ATTRIBUTION=""

# Optional basemap provider keys. Only the provider actually in use needs a key.
MAPTILER_API_KEY=""
STADIA_API_KEY=""
PROTOMAPS_API_KEY=""


# ──────────────────────────────────────────────────────────────────────────────
# NASA Earthdata Login
# ──────────────────────────────────────────────────────────────────────────────
# A single Earthdata Login token authenticates against most NASA DAACs
# (GES DISC, LAADS DAAC, LP DAAC, NSIDC, ORNL DAAC).
# Register: https://urs.earthdata.nasa.gov/users/sign_in
# Generate a token: https://urs.earthdata.nasa.gov/users/token
#
# NASA POWER requires NO authentication. SMAP / GPM / MODIS / Landsat via
# Earthdata CMR, DAAC search and GES DISC DO require Earthdata Login.
NASA_EARTHDATA_USERNAME=""
NASA_EARTHDATA_TOKEN=""

# Some NASA services accept a plain bearer token; set only if required.
NASA_EARTHDATA_BEARER_TOKEN=""


# ──────────────────────────────────────────────────────────────────────────────
# Google Earth Engine (OPTIONAL, pending ADR)
# ──────────────────────────────────────────────────────────────────────────────
# GEE is used for zonal statistics over raster products (SMAP, MODIS, Landsat)
# and for precipitation products not otherwise accessible.
# It requires a Cloud Project that is registered for the intended use.
# Availability, quota and non-commercial verification terms MUST be confirmed
# before relying on it. See docs/api/google-earth-engine.md.
GEE_PROJECT_ID=""
GEE_SERVICE_ACCOUNT_EMAIL=""
GEE_PRIVATE_KEY=""


# ──────────────────────────────────────────────────────────────────────────────
# Crop reference data (optional)
# ──────────────────────────────────────────────────────────────────────────────
# Access to maintained crop calendars / agronomic requirement datasets.
# Currently the crop requirement catalog is versioned in-repo as JSON/TS,
# so no key is required. This variable is reserved for a future hosted source.
CROP_DATA_API_URL=""
CROP_DATA_API_KEY=""

# Agromet / local weather station observations (optional, phase 2+)
AGROMET_API_URL=""
AGROMET_API_KEY=""


# ──────────────────────────────────────────────────────────────────────────────
# LLM provider (OPTIONAL, explain-only, not for recommendation logic)
# ──────────────────────────────────────────────────────────────────────────────
# If enabled, the model may only rewrite engine output into plain language.
# It must NEVER determine suitability scores, verdicts, or agronomic facts.
# The recommendation engine is deterministic and rules-based.
# See docs/product/recommendation-methodology.md.
LLM_PROVIDER=""            # e.g. "groq" | "openai" | "anthropic"
LLM_API_KEY=""
LLM_MODEL=""

# Groq, if the optional paraphrase path is used. The comparison engine is
# deterministic and does NOT need this. It is only for rewriting engine
# output into plainer language for the farmer.
GROQ_API_KEY=""


# ──────────────────────────────────────────────────────────────────────────────
# Observability (optional)
# ──────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""
