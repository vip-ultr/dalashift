# Line endings.
#
# The repository stores LF. Every platform, including Windows, checks out LF,
# so that `pnpm format:check` produces the same result on a developer's
# machine and in CI. Without this, a Windows checkout with the default
# `core.autocrlf=true` rewrites every tracked text file to CRLF and the
# formatting check fails locally while passing in CI.
#
# See CONTRIBUTING.md and .editorconfig.
* text=auto eol=lf

# Binary assets. Never line-ending normalised.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.webp  binary
*.woff  binary
*.woff2 binary
*.pdf   binary
*.pptx  binary
*.docx  binary
*.mp3   binary
*.m4a   binary
*.wav   binary
*.zip   binary
*.gz    binary
